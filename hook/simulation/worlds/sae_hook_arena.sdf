<?xml version="1.0" ?>
<!--
  SAE Eletroquad 2026 — Mission 2: Hang the Right Wire

  Arena: 7m-diameter circle with two red hoses at 1.7m height on support
  posts, one orange sphere (25cm) marking the correct hose, and a takeoff
  base at center. Down camera Arducam IMX662 (87deg horizontal FOV).

  Usage:
    gz sim -v4 -r sae_hook_arena.sdf
-->
<sdf version="1.9">
  <world name="sae_hook_arena">

    <!-- Physics -->
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat"/>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.6 0.75 0.9</background>
      <sky></sky>
    </scene>

    <!-- GUI -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.6 0.75 0.9</background_color>
        <camera_pose>-6 -6 10 0 0.7 0.5</camera_pose>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">145</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>false</iterations>
      </plugin>
      <plugin filename="ImageDisplay" name="Down Camera">
        <gz-gui>
          <property type="string" key="state">docked_collapsed</property>
        </gz-gui>
        <topic>/down_camera</topic>
      </plugin>
      <plugin filename="TopicEcho" name="Topic Echo">
        <gz-gui>
          <property type="string" key="state">docked_collapsed</property>
        </gz-gui>
      </plugin>
    </gui>

    <!-- GPS origin (Canberra default, matches ArduPilot SITL) -->
    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <!-- Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
          <material>
            <ambient>0.35 0.5 0.3 1</ambient>
            <diffuse>0.35 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════════
         SAE M2 Arena Elements
         ══════════════════════════════════════════════════════════════ -->

    <!-- Takeoff base (blue circle at center) -->
    <model name="takeoff_base">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.5</radius><length>0.01</length></cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.2 0.8 1</ambient>
            <diffuse>0.15 0.3 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Arena boundary ring (visual only, 7m diameter = 3.5m radius) -->
    <model name="arena_boundary">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="ring">
          <geometry>
            <cylinder><radius>3.5</radius><length>0.005</length></cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 0.4</ambient>
            <diffuse>0.95 0.95 0.95 0.4</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Hose A (y=+1.25, the one WITH the sphere) ─────────────── -->
    <model name="hose_a">
      <static>true</static>
      <pose>0 1.25 1.7 0 1.5708 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.00635</radius><length>8.0</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.00635</radius><length>8.0</length></cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Hose A support posts -->
    <model name="hose_a_post_1">
      <static>true</static>
      <pose>-4.0 1.25 0.85 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.08 0.08 1.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 0.08 1.7</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="hose_a_post_2">
      <static>true</static>
      <pose>4.0 1.25 0.85 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.08 0.08 1.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 0.08 1.7</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Orange sphere on Hose A -->
    <model name="sphere_marker">
      <static>true</static>
      <pose>2.0 1.25 1.7 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <sphere><radius>0.125</radius></sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere><radius>0.125</radius></sphere>
          </geometry>
          <material>
            <ambient>1.0 0.5 0.0 1</ambient>
            <diffuse>1.0 0.55 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Hose B (y=-1.25, no sphere) ───────────────────────────── -->
    <model name="hose_b">
      <static>true</static>
      <pose>0 -1.25 1.7 0 1.5708 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.00635</radius><length>8.0</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.00635</radius><length>8.0</length></cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Hose B support posts -->
    <model name="hose_b_post_1">
      <static>true</static>
      <pose>-4.0 -1.25 0.85 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.08 0.08 1.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 0.08 1.7</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="hose_b_post_2">
      <static>true</static>
      <pose>4.0 -1.25 0.85 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.08 0.08 1.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 0.08 1.7</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════════
         Drone + Sensors
         ══════════════════════════════════════════════════════════════ -->

    <!-- Iris quadcopter (ardupilot_gazebo model) -->
    <include>
      <uri>model://iris_with_gimbal</uri>
      <name>iris</name>
      <pose degrees="true">0 0 0.195 0 0 0</pose>
    </include>

    <!-- Downward RGB camera (Arducam 2MP IMX662)
         Specs: 1920x1080, FOV 102(D) x 86(H) x 47(V), EFL 3.9mm, F1.0 -->
    <model name="down_camera">
      <static>false</static>
      <pose relative_to="iris::iris_with_standoffs::base_link">0.03 0 -0.04 0 1.5708 0</pose>
      <link name="link">
        <inertial>
          <mass>0.03</mass>
          <inertia>
            <ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1e-6</iyy><iyz>0</iyz>
            <izz>1e-6</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><box><size>0.02 0.02 0.015</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <sensor name="down_rgb" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <topic>/down_camera</topic>
          <camera>
            <horizontal_fov>1.5009</horizontal_fov>
            <image>
              <width>1920</width>
              <height>1080</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>50.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>
    <joint name="down_camera_joint" type="fixed">
      <parent>iris::iris_with_standoffs::base_link</parent>
      <child>down_camera::link</child>
    </joint>

    <!-- Downward lidar rangefinder (TFLuna) -->
    <model name="lidar_rangefinder">
      <static>false</static>
      <pose relative_to="iris::iris_with_standoffs::base_link">-0.03 0 -0.05 0 1.5708 0</pose>
      <link name="link">
        <inertial>
          <mass>0.03</mass>
          <inertia>
            <ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1e-6</iyy><iyz>0</iyz>
            <izz>1e-6</izz>
          </inertia>
        </inertial>
        <sensor name="lidar_rangefinder" type="gpu_lidar">
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <topic>/lidar/range</topic>
          <ray>
            <scan>
              <horizontal>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.1</min>
              <max>8.0</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
        </sensor>
      </link>
    </model>
    <joint name="lidar_joint" type="fixed">
      <parent>iris::iris_with_standoffs::base_link</parent>
      <child>lidar_rangefinder::link</child>
    </joint>

  </world>
</sdf>
