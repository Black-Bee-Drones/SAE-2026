# --- Mission runtime artifacts ---
# DETECTION_SAVE_PATH defaults to ~/sae2026 (outside the repo);
# ignore the in-tree path too in case it's overridden.
hook/sae2026/
sae2026/
*.bag
*.db3

# --- Simulation runtime ---
# Temp SDF files rendered by sae_hook.launch.py go to /tmp by default,
# but ignore in-tree just in case.
hook/simulation/worlds/sae_hook_arena_runtime*.sdf
sae_hook_arena_*.sdf
!hook/simulation/worlds/sae_hook_arena.sdf

# --- Models: KEEP tracked (.pt weights live here on purpose) ---
